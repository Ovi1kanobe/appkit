# Copy to .env for make dev; the app reads only the environment, never this file.
# Every variable is declared in main.go, and startup lists any that are missing.

# Rauthy issuer URL exactly as Rauthy reports it, including any trailing slash.
RAUTHY_ISSUER=
# Rauthy client ID, and the secret for a confidential client.
RAUTHY_CLIENT_ID=
RAUTHY_CLIENT_SECRET=
# Public origin users open.
APP_ORIGIN=http://localhost:8080
# Where a request's client address comes from: remote for make dev on localhost, where nothing sits in front of the app;
# header:X-Forwarded-For, or the header the reverse proxy sets, in production.
CLIENT_ADDRESS=remote
# Base64 key that encrypts stored credentials: openssl rand -base64 32. Keep a copy outside the server.
APP_MASTER_KEY=

# Optional, shown with their defaults.
#LISTEN_ADDRESS=127.0.0.1:8080
#DATABASE_PATH=app.sqlite
#SESSION_DATABASE=appkit-sessions.sqlite
